{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VIPPotato/peachy-installer-repo/blob/main/schemas/catalog.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "const": "peachy-installer"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "origin": {
      "type": "object",
      "properties": {
        "provider": {
          "const": "github"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "maxLength": 200
        },
        "branch": {
          "const": "main"
        }
      },
      "required": [
        "provider",
        "repository",
        "branch"
      ],
      "additionalProperties": false
    },
    "trust": {
      "type": "object",
      "properties": {
        "state": {
          "const": "unsigned"
        },
        "signature": {
          "type": "null"
        }
      },
      "required": [
        "state",
        "signature"
      ],
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._/-]*[.]json$",
            "maxLength": 240
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 128
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "generatedAt",
    "expiresAt",
    "origin",
    "trust",
    "entries"
  ],
  "additionalProperties": false
}
